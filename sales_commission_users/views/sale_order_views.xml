<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    To add a new tab for sales commission-->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">
            sale.order.view.form.inherit.sales.commission.users
        </field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']" position="after">
                <page string="Sales Commission">
                    <field name="commission_ids">
                        <tree create="0">
                            <field name="date"/>
                            <field name="description"/>
                             <field name="sales_person_id" />
                             <field name="order_ref" />
                             <field name="partner_id" />
                            <field name="commission_amount" sum="Total"/>
                        </tree>
                    </field>
                </page>
            </xpath>
             <xpath expr="//field[@name='vehicle_no']" position="after">
                <field name="commission_type_id" readonly="state != 'draft'"/>
            </xpath>
            <xpath expr="//field[@name='article']" position="after">

                <field name="salesperson_ids" widget="many2many_tags" string="Commission Sales Persons"/>             </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_with_onboarding_inherited" model="ir.ui.view">
        <field name="name">
            sale.order.tree.inherit.sales.commission.users
        </field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <field name="user_id" position="replace">
                <field name="salesperson_ids" widget="many2many_tags"/>
            </field>
        </field>
    </record>

    <record id="view_sales_order_filter_inherited" model="ir.ui.view">
        <field name="name">
            sale.order.search.inherit.sales.commission.users
        </field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="salesperson" position="attributes">
                <attribute name="context">{'group_by': 'salesperson_ids'}</attribute>
            </filter>
        </field>
    </record>
</odoo>
