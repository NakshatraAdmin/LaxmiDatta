<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Template for sales commission report-->
    <template id="report_sales_commission">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>
                        <center>
                            <strong>Sales Commission Reports</strong>
                        </center>
                    </h2>
                </div>
                <h5>
                    <center>
                        <strong>
                            <tr>
                                <t t-if="data.get('start_date')">
                                    <t t-if="data.get('end_date')">
                                        <td>
                                            <t t-esc="data['start_date']"/>
                                            to
                                            <t t-esc="data['end_date']"/>
                                        </td>
                                    </t>
                                </t>
                            </tr>
                        </strong>
                    </center>
                </h5>
                <h5>
                    <center>
                        <strong>
                            <tr>
                                <t t-if="data.get('sales_person_ids')">
                                     <td>
                                        Salesperson :
                                        <t t-foreach="data['sales_person_ids']" t-as="sp_id">
                                            <t t-set="sp" t-value="env['hr.employee'].browse(sp_id)"/>
                                            <span t-esc="sp.name"/><span>,</span> </t>
                                    </td>
                                </t>
                            </tr>
                        </strong>
                    </center>
                </h5>
                <br/>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Invoice Date</th>
                            <th>Invoice No.</th>
                            <th>Sales Order No.</th>
                            <th>Customer Name</th>
                            <th style="text-align: right;">Untaxed Amount</th>
                            <th style="text-align: right;">Commission Amount</th>
                        </tr>
                    </thead>

                    <tbody>
                        <t t-foreach="docs" t-as="d">
                            <tr>
                                <td>
                                    <span t-esc="d['invoice_date']"/>
                                </td>
                                <td>
                                    <span t-esc="d['invoice_no']"/>
                                </td>
                                <td>
                                    <span t-esc="d['sale_order_no']"/>
                                </td>
                                <td>
                                    <span t-esc="d['customer_name']"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="'{:,.2f}'.format(d['untaxed_amount'] or 0.0)"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="'{:,.2f}'.format(d['commission_amount'] or 0.0)"/>
                                </td>

                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>
    </template>
</odoo>
