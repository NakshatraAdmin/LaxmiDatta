<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Odoo 17 requires every unit of measure to belong to a category.  Version
        19 removed that requirement and uses ``relative_factor`` instead of the
        version 17 ``factor_inv``/``uom_type`` fields.

        These UQCs are kept in their own category so they do not accidentally
        convert to Odoo's standard length, weight, volume, or time units.
    -->
    <record id="uom_category_tally_uqc" model="uom.category">
        <field name="name">Tally UQC</field>
    </record>

    <record id="uom_uom_bag" model="uom.uom">
        <field name="name">Bags</field>
        <field name="category_id" ref="uom_category_tally_uqc"/>
        <field name="factor_inv" eval="1.0"/>
        <field name="uom_type">reference</field>
        <field name="l10n_in_code">BAG</field>
    </record>
    <record id="uom_uom_bal" model="uom.uom">
