<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tally_dashboard_kanban" model="ir.ui.view">
        <field name="name">tally.dashboard.kanban</field>
        <field name="model">tally.dashboard</field>
        <field name="arch" type="xml">
            <kanban create="0" delete="0">
                <field name="name"/>
                <field name="code"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-3">
                            <div class="o_kanban_record_top mb-3">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title" style="font-size: 16px;">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body mt-2">
                                <t t-if="record.code.raw_value == 'uom'">
                                    <button name="action_push_uom_to_tally" type="object" class="btn btn-primary">
                                        Push UOM to Tally
                                    </button>
                                </t>
                                <t t-if="record.code.raw_value == 'customer'">
                                    <button name="action_push_customer_to_tally" type="object" class="btn btn-primary">
                                        Push Customers to Tally
                                    </button>
                                </t>
                                <t t-if="record.code.raw_value == 'invoice'">
                                    <button name="action_push_invoice_to_tally" type="object" class="btn btn-primary">
                                        Push Invoices to Tally
                                    </button>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_tally_dashboard" model="ir.actions.act_window">
        <field name="name">Integration Overview</field>
        <field name="res_model">tally.dashboard</field>
        <field name="view_mode">kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tally Integration Dashboard
            </p>
        </field>
    </record>
</odoo>
