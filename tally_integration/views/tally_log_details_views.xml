<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tally_log_details_tree" model="ir.ui.view">
        <field name="name">tally.log.details.list</field>
        <field name="model">tally.log.details</field>
        <field name="arch" type="xml">
            <tree string="Integration Log Details" create="0">
                <field name="integration_name"/>
                <field name="remark"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="count"/>
            </tree>
        </field>
    </record>

    <record id="view_tally_log_details_form" model="ir.ui.view">
        <field name="name">tally.log.details.form</field>
        <field name="model">tally.log.details</field>
        <field name="arch" type="xml">
            <form string="Integration Log Details" create="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="integration_name" placeholder="Integration Name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="remark" readonly="1"/>
                            <field name="count" readonly="1"/>
                        </group>
                        <group>
                            <field name="start_date" readonly="1"/>
                            <field name="end_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attachment(s)" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary" readonly="1"/>
                        </page>
                        <page string="JSON Log" name="json_log">
                            <field name="json_log" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tally_log_details" model="ir.actions.act_window">
        <field name="name">Log Details</field>
        <field name="res_model">tally.log.details</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No integration log records found!
            </p>
        </field>
    </record>
</odoo>
