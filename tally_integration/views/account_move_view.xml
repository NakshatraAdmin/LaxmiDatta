<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_account_move_send_to_tally" model="ir.actions.server">
        <field name="name">Send To Tally</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">tree,form</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_send_to_tally()
        </field>
    </record>

    <record id="view_move_form_inherit_tally" model="ir.ui.view">
        <field name="name">account.move.form.inherit.tally</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="is_tally"/>
            </xpath>
        </field>
    </record>
</odoo>
