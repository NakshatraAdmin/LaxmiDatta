<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_product_configurator" model="ir.ui.view">
        <field name="name">purchase.order.form.product.configurator</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_template_id']" position="attributes">
                <attribute name="widget">purchase_product_many2one</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_template_id']" position="after">
                <field name="product_template_attribute_value_ids" column_invisible="1"/>
                <field name="product_no_variant_attribute_value_ids" column_invisible="1"/>
                <field name="is_configurable_product" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="attributes">
                <attribute name="optional">hide</attribute>
                <attribute name="string">Product Variant</attribute>
                <attribute name="widget">purchase_product_many2one</attribute>
            </xpath>
        </field>
    </record>
</odoo>
