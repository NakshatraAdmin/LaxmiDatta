<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_laxmidatta_stock_a4" model="report.paperformat">
        <field name="name">Laxmidatta Stock Slips A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="stock.action_report_delivery" model="ir.actions.report">
        <field name="paperformat_id" ref="custom_inventory_report.paperformat_laxmidatta_stock_a4"/>
    </record>

    <record id="stock.action_report_picking" model="ir.actions.report">
        <field name="paperformat_id" ref="custom_inventory_report.paperformat_laxmidatta_stock_a4"/>
    </record>
</odoo>