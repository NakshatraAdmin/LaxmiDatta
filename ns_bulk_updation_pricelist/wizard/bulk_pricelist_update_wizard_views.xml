<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Bulk Pricelist Update Wizard Form View -->
        <record id="view_bulk_pricelist_update_wizard_form" model="ir.ui.view">
            <field name="name">bulk.pricelist.update.wizard.form</field>
            <field name="model">bulk.pricelist.update.wizard</field>
            <field name="arch" type="xml">
                <form string="Bulk Update Prices">
                    <sheet>
                        <group>
                            <group string="Pricelist &amp; Target Scope">
                                <field name="pricelist_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="apply_on" widget="radio"/>
                                <field name="pricelist_item_ids"
                                       invisible="apply_on != 'selected_items'"
                                       required="apply_on == 'selected_items'"
                                       widget="many2many_tags"
                                       domain="[('pricelist_id', 'in', pricelist_ids)]"/>
                                <field name="category_ids"
                                       invisible="apply_on != 'category'"
                                       required="apply_on == 'category'"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"/>
                                <field name="category_id"
                                       invisible="apply_on != 'products_under_category'"
                                       required="apply_on == 'products_under_category'"
                                       options="{'no_create': True}"/>
                            </group>
                            <group string="Price Adjustment Rules">
                                <field name="computation_method" widget="radio" invisible="apply_on == 'products_under_category'"/>
                                <field name="value" invisible="apply_on == 'products_under_category'"/>
                                <field name="min_quantity"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                            </group>
                        </group>
                        <notebook invisible="apply_on != 'products_under_category'">
                            <page string="Products">
                                <field name="product_line_ids">
                                    <tree editable="bottom" create="false" delete="false">
                                        <field name="product_id" readonly="1" force_save="1"/>
                                        <field name="base_price"/>
                                        <field name="current_price" readonly="1" force_save="1"/>
                                        <field name="new_price"/>
                                        <field name="price_difference" readonly="1" force_save="1"/>
                                        <field name="effective_from"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="action_apply_bulk_update"
                                string="Apply Changes"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Bulk Pricelist Update Action -->
        <record id="action_bulk_pricelist_update_wizard" model="ir.actions.act_window">
            <field name="name">Bulk Update Prices</field>
            <field name="res_model">bulk.pricelist.update.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Bulk Pricelist Update Menu Item -->
        <menuitem id="menu_bulk_pricelist_update_wizard"
                  name="Bulk Update Prices"
                  action="action_bulk_pricelist_update_wizard"
                  parent="sale.product_menu_catalog"
                  sequence="35"/>

    </data>
</odoo>
