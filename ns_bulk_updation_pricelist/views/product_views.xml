<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Product Template Form View to add Pricelist Rules tab -->
        <record id="product_template_form_view_inherit_pricelist_rules" model="ir.ui.view">
            <field name="name">product.template.form.inherit.pricelist.rules</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Pricelist Rules" name="pricelist_rules" groups="product.group_product_pricelist">
                        <field name="pricelist_rule_ids" context="{'default_product_tmpl_id': id, 'default_applied_on': '1_product'}"/>
                        <!-- <field name="pricelist_rule_ids">
                            <tree editable="bottom">
                                <field name="company_id" column_invisible="1"/>
                                <field name="pricelist_id"/>
                                <field name="name" string="Applied On"/>
                                <field name="price"/>
                                <field name="min_quantity"/>
                                <field name="date_start" optional="hide"/>
                                <field name="date_end" optional="hide"/>
                                <field name="product_tmpl_id" column_invisible="True"/>
                            </tree>
                        </field> -->
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Inherit Product Product Form View to set context for Pricelist Rules -->
        <record id="product_normal_form_view_inherit_pricelist_rules" model="ir.ui.view">
            <field name="name">product.product.form.inherit.pricelist.rules</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='pricelist_rule_ids']" position="attributes">
                    <attribute name="context">{'default_product_id': id, 'default_applied_on': '0_product_variant'}</attribute>
                </xpath>
            </field>
        </record>

        <!-- Inherit Product Pricelist Item Form View to show pricelist_id field -->
        <record id="product_pricelist_item_form_view_inherit" model="ir.ui.view">
            <field name="name">product.pricelist.item.form.inherit.pricelist</field>
            <field name="model">product.pricelist.item</field>
            <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='pricelist_rule_related']/field[@name='pricelist_id']" position="replace"/>
                <xpath expr="//group[@name='pricelist_rule_computation']" position="before">
                    <group name="pricelist_rule_header">
                        <field name="pricelist_id" required="1" options="{'no_create': True}"/>
                    </group>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
